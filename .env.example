# Business One Merchant Platform — Environment (LOCAL ONLY)

# Do not deploy this template until you are ready. Copy to backend/.env

DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=business_one_merchant

# Use a different port than HM Herbs (3001)
PORT=3011
NODE_ENV=development
FRONTEND_URL=http://127.0.0.1:3011

JWT_SECRET=change-me-local-merchant-template

# Product flags — default: no website face (admin + POS only)
FEATURE_WEBSITE=false
FEATURE_PHONES=true
FEATURE_LOYALTY=true
FEATURE_GIFT_CARDS=true
FEATURE_EDSA=false

BRAND_PLATFORM_NAME=Business One
BRAND_STORE_NAME=Business One Merchant
BRAND_PRIMARY=#ff9b1f
BRAND_ACCENT=#1f82ff
BRAND_INK=#0f172a
BRAND_LOGO_URL=/images/business-one/logo-big.png

# Link to local Business One Phone (PBX) merchant
PBX_API_ORIGIN=http://127.0.0.1:3040
PBX_MERCHANT_ID=
PBX_ADMIN_PIN=2468
